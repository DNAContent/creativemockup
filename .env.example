# Supabase — Project Settings -> API
# Safe to expose: protection comes from RLS + role-tier policies (see db/rls.sql
# and db/04_team_client_access.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public origin of the deployed app, e.g. https://mockups.youragency.com
# Used to build magic-link redirect URLs. Falls back to the request host if
# unset, but set it explicitly in production for reliable email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notifications (db/06_notifications.sql) --------------------------------
# Service-role key — Supabase -> Project Settings -> API -> service_role.
# SERVER-ONLY and secret: it bypasses RLS. Used only by the notify webhook.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Shared secret guarding /api/hooks/notify. Must match notify_config.secret in
# the database (set via: update public.notify_config set secret = '…').
# Generate one, e.g.: openssl rand -hex 32
NOTIFY_HOOK_SECRET=GENERATE-A-LONG-RANDOM-STRING
